// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String
  telefone     String
  cpf          String
  dataCadastro DateTime @default(now())

  pedidos Pedido[]
}

model Flor {
  id         Int     @id @default(autoincrement())
  nome       String
  cor        String
  preco      Float
  estoque    Int
  imagem     String?
  disponivel Boolean @default(true)

  pedidos PedidoFlor[]
}

model Pedido {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  dataPedido DateTime @default(now())
  valorTotal Float

  cliente Cliente @relation(fields: [clienteId], references: [id])

  flores PedidoFlor[]
}

model PedidoFlor {
  id Int @id @default(autoincrement())

  pedidoId Int
  florId   Int

  quantidade Int

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  flor Flor @relation(fields: [florId], references: [id])
}
